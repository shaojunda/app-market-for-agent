{
  "$schema": "../schema/manifest.schema.json",
  "id": "photo-retouch",
  "name": "智能人像修图",
  "description": "对人像照片进行美颜、去瑕疵、调色，以及去除背景。当用户需要美化人像照片或制作透明背景人像图时使用。",
  "version": "1.0.0",
  "tags": [
    "image",
    "photo",
    "retouch",
    "background-removal"
  ],
  "provider": {
    "name": "Example Studio",
    "contact": "dev@example.com",
    "website": "https://example.com"
  },
  "payment": {
    "network": "base",
    "asset": "USDC"
  },
  "actions": [
    {
      "id": "retouch",
      "description": "人像美颜和调色，返回处理后的图片",
      "endpoint": {
        "url": "https://api.example.com/v1/retouch",
        "method": "POST",
        "content_type": "application/json"
      },
      "price": "0.05",
      "timeout_seconds": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string",
            "description": "图片 URL，或 data URI 格式的 base64（data:image/jpeg;base64,...），最大 10MB"
          },
          "style": {
            "type": "string",
            "enum": [
              "natural",
              "beauty",
              "film"
            ],
            "default": "natural",
            "description": "修图风格。natural 为自然修饰，beauty 为明显美颜，film 为胶片调色"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result_url": {
            "type": "string",
            "description": "处理后的图片地址（JPEG），24 小时内有效"
          }
        }
      },
      "example": {
        "request": {
          "image": "https://example.com/samples/portrait.jpg",
          "style": "natural"
        },
        "response": {
          "result_url": "https://cdn.example.com/results/abc123.jpg"
        }
      }
    },
    {
      "id": "remove-background",
      "description": "去除人像背景，返回透明背景 PNG",
      "endpoint": {
        "url": "https://api.example.com/v1/remove-background",
        "method": "POST",
        "content_type": "application/json"
      },
      "price": "0.02",
      "timeout_seconds": 20,
      "input_schema": {
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string",
            "description": "图片 URL，或 data URI 格式的 base64，最大 10MB"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result_url": {
            "type": "string",
            "description": "透明背景 PNG 的地址，24 小时内有效"
          }
        }
      },
      "example": {
        "request": {
          "image": "https://example.com/samples/portrait.jpg"
        },
        "response": {
          "result_url": "https://cdn.example.com/results/def456.png"
        }
      }
    }
  ]
}
