{
  "$schema": "../schema/manifest.schema.json",
  "id": "voice-tts",
  "name": "多语种语音合成",
  "description": "把文字转换成自然的语音，支持 20 种语言和多种音色。当用户需要朗读文本或生成配音音频时使用。",
  "version": "1.2.0",
  "tags": [
    "audio",
    "tts",
    "voice"
  ],
  "provider": {
    "name": "Sonic Works",
    "contact": "hello@sonicworks.example"
  },
  "payment": {
    "network": "eip155:8453",
    "asset": "USDC"
  },
  "actions": [
    {
      "id": "synthesize",
      "description": "合成语音，返回 MP3 地址；每次最多 5000 字",
      "endpoint": {
        "url": "https://tts.sonicworks.example/v1/synthesize",
        "method": "POST",
        "content_type": "application/json"
      },
      "price": "0.02",
      "timeout_seconds": 60,
      "input_schema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "description": "要合成的文字"
          },
          "language": {
            "type": "string",
            "default": "zh",
            "description": "语言代码，例如 zh、en、ja"
          },
          "voice": {
            "type": "string",
            "enum": [
              "female-warm",
              "female-bright",
              "male-calm",
              "male-deep"
            ],
            "default": "female-warm",
            "description": "音色"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "audio_url": {
            "type": "string",
            "description": "MP3 文件地址，24 小时内有效"
          },
          "duration_seconds": {
            "type": "number",
            "description": "音频时长"
          }
        }
      },
      "example": {
        "request": {
          "text": "你好，欢迎使用语音合成。",
          "voice": "male-calm"
        },
        "response": {
          "audio_url": "https://cdn.sonicworks.example/a/xyz.mp3",
          "duration_seconds": 2.4
        }
      }
    }
  ]
}
