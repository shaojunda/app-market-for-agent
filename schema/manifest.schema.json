{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shaojunda.github.io/app-market-for-agent/schema/manifest.schema.json",
  "title": "App Market Manifest",
  "description": "卖方 Agent 上架应用时提交的 manifest，每个应用一份，文件名为 registry/<id>.json。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "provider", "payment", "actions"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "可选，指向本 schema，方便编辑器校验和补全。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "全局唯一标识，只能用小写字母、数字和 -，必须与文件名一致。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "应用名称。"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "最重要的字段，Agent 靠它判断要不要使用这个应用。写清楚“能做什么”和“什么时候该用”。"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "manifest 版本号（semver），每次修改都要递增。"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true,
      "maxItems": 10,
      "description": "分类标签，辅助搜索，只能用小写字母、数字和 -。"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contact"],
      "description": "卖方信息。",
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "卖方名称。" },
        "contact": { "type": "string", "minLength": 3, "description": "联系方式（邮箱等），用于审核和问题反馈。" },
        "website": { "type": "string", "pattern": "^https://", "description": "卖方网站。" }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "asset"],
      "description": "收款网络和币种，必须与服务端 402 响应一致。收款地址由 402 响应动态提供，不在这里登记。",
      "properties": {
        "network": {
          "type": "string",
          "enum": ["eip155:8453", "eip155:84532"],
          "description": "收款网络，使用 x402 v2 的 CAIP-2 格式，与 402 响应中的 network 字段一致。eip155:8453 为 Base 主网，eip155:84532 为 Base Sepolia 测试网。"
        },
        "asset": {
          "type": "string",
          "enum": ["USDC"],
          "description": "收款币种，指该网络上的官方 USDC 合约。"
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "description": "应用提供的能力列表，每个 action 对应一个 endpoint。",
      "items": { "$ref": "#/definitions/action" }
    }
  },
  "definitions": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "endpoint", "price", "input_schema", "output_schema", "example"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "action 标识，在应用内唯一。"
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "这个 action 做什么。"
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "method", "content_type"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://", "description": "服务地址，必须是 HTTPS。" },
            "method": { "type": "string", "enum": ["GET", "POST"], "description": "HTTP 方法。" },
            "content_type": {
              "type": "string",
              "enum": ["application/json"],
              "description": "请求体格式。"
            }
          }
        },
        "price": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)(\\.\\d{1,6})?$",
          "description": "单次价格，十进制字符串，单位为 payment.asset，最多 6 位小数。仅用于展示，实际以 402 响应为准，两者必须一致。"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "预计最长处理时间（秒）。"
        },
        "input_schema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } },
          "description": "请求体的 JSON Schema，每个字段都要写 description。"
        },
        "output_schema": {
          "type": "object",
          "required": ["type"],
          "description": "响应体的 JSON Schema。"
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "response"],
          "description": "一组真实可用的请求和响应示例，审核时会实际调用。",
          "properties": {
            "request": { "type": "object" },
            "response": {}
          }
        }
      }
    }
  }
}
